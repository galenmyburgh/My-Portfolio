# Overrides the production origin baked into src/lib/site.ts.
# Set this on preview deployments so they don't advertise production canonicals.
# Absolute origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://galenmyburgh.com

# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it to the
# browser. Without it, the contact form tells visitors to email directly rather
# than failing silently.
RESEND_API_KEY=
CONTACT_TO_EMAIL=galen.myburgh46@gmail.com
