# Copy to .env.local for local development, and set the same keys in the
# Netlify dashboard under Site settings > Environment variables.
#
# Note: EmailJS browser keys are public by design — they are readable in the
# shipped bundle no matter where you store them. The control that actually
# protects your quota is the domain allowlist in the EmailJS dashboard
# (Account > Security > Allowed domains). Set it to galenmyburgh.com.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Absolute site URL, no trailing slash. Used for canonical + Open Graph tags.
REACT_APP_SITE_URL=https://galenmyburgh.com
